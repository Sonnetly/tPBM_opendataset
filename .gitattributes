# Keep uploaded input bytes intact and recognize its original CRLF line endings.
ora_analysis/input/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Excel outputs must never undergo text line-ending conversion.
*.xlsx -text

# Preserve the archived analysis inputs and the user's original plan byte-for-byte.
allen_mop_visp/input/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
allen_mop_visp/docs/MOp_VISp_Allen_analysis_plan_ko.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
# These official HTML snapshots contain trailing indentation and blank final lines.
allen_mop_visp/input/coverage/*_gene_list.html -text whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
*.zip -text
